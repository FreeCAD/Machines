{
    "freecad_version": "26.3.0",
    "machine": {
        "name": "Generic KineticNC Plasma",
        "manufacturer": "",
        "description": "Generic plasma table running the KineticNC / Beamicon2 control (cnc-step.com / Benezan Electronics). Travels match the 1000 x 600 x 300 mm envelope of the machines the deprecated KineticNCBeamicon2 post was written for; adjust them, the rapid rates and the pierce/cooling delays to match your table, torch and consumables before cutting.",
        "units": "metric",
        "kinematics": {
            "base_frame": {
                "origin": [
                    0,
                    0,
                    0
                ],
                "orientation_quaternion": [
                    0,
                    0,
                    0,
                    1
                ]
            },
            "tcp_supported": false,
            "dwo_supported": false,
            "notes": ""
        },
        "axes": {
            "X": {
                "type": "linear",
                "role": "table_linear",
                "parent": null,
                "sequence": 0,
                "joint": [
                    [
                        0,
                        0,
                        0
                    ],
                    [
                        1.0,
                        0.0,
                        0.0
                    ]
                ],
                "limits": {
                    "min": 0,
                    "max": 1000
                },
                "max_velocity": 10000
            },
            "Y": {
                "type": "linear",
                "role": "table_linear",
                "parent": null,
                "sequence": 0,
                "joint": [
                    [
                        0,
                        0,
                        0
                    ],
                    [
                        0.0,
                        1.0,
                        0.0
                    ]
                ],
                "limits": {
                    "min": 0,
                    "max": 600
                },
                "max_velocity": 10000
            },
            "Z": {
                "type": "linear",
                "role": "head_linear",
                "parent": null,
                "sequence": 0,
                "joint": [
                    [
                        0,
                        0,
                        0
                    ],
                    [
                        0.0,
                        0.0,
                        1.0
                    ]
                ],
                "limits": {
                    "min": 0,
                    "max": 300
                },
                "max_velocity": 10000
            }
        },
        "toolheads": [
            {
                "name": "Plasma Torch",
                "toolhead_type": "plasma",
                "max_power_kw": 0,
                "max_rpm": 0,
                "min_rpm": 0,
                "tool_change": "none",
                "coolant_flood": false,
                "coolant_mist": false,
                "coolant_delay": 0.0,
                "toolhead_wait": 0.0,
                "plasma_amperage": 45.0,
                "id": "toolhead1"
            }
        ]
    },
    "version": 1,
    "postprocessor": {
        "file_name": "generic_plasma",
        "properties": {
            "file_extension": "ncc",
            "preamble": "%\nG17 G54 G40 G49 G80 G90",
            "postamble": "M05\nG17 G54 G90 G80 G40\nM30"
        }
    },
    "output": {
        "units": "metric",
        "output_tool_length_offset": false,
        "remote_post": false,
        "header": {
            "output_header": true,
            "include_date": true,
            "include_description": true,
            "include_document_name": true,
            "include_machine_name": true,
            "include_project_file": false,
            "include_units": true,
            "include_tool_list": false,
            "include_fixture_list": false
        },
        "comments": {
            "enabled": true,
            "symbol": "(",
            "include_operation_labels": true,
            "include_blank_lines": false,
            "output_bcnc_comments": false
        },
        "formatting": {
            "line_numbers": false,
            "line_number_start": 100,
            "line_number_prefix": "N",
            "line_increment": 10,
            "command_space": " ",
            "end_of_line_chars": "\n"
        },
        "precision": {
            "axis": 3,
            "feed": 3,
            "spindle": 0
        },
        "duplicates": {
            "commands": true,
            "parameters": true
        }
    },
    "processing": {
        "early_tool_prep": false,
        "filter_inefficient_moves": true,
        "split_arcs": false,
        "tool_change": false,
        "translate_drill_cycles": false,
        "translate_rapid_moves": false,
        "xy_before_z_after_tool_change": false
    }
}