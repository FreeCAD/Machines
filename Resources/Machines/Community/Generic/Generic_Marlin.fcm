{
    "freecad_version": "1.0",
    "machine": {
        "name": "Generic Marlin",
        "manufacturer": "",
        "description": "Generic 3-axis CNC machine running Marlin 2.x firmware. Marlin uses G4 S for dwell in seconds (not G4 P). Drill cycles are translated to G0/G1 moves. Tool changes are disabled.",
        "units": "metric",
        "kinematics": {
            "base_frame": {
                "origin": [0, 0, 0],
                "orientation_quaternion": [0, 0, 0, 1]
            },
            "tcp_supported": false,
            "dwo_supported": false,
            "notes": "Standard 3-axis Cartesian configuration for Marlin-based CNC"
        },
        "axes": {
            "X": {
                "type": "linear",
                "role": "table_linear",
                "parent": null,
                "sequence": 0,
                "joint": [[0, 0, 0], [1, 0, 0]],
                "limits": {"min": -1000.0, "max": 1000.0},
                "max_velocity": 5000.0
            },
            "Y": {
                "type": "linear",
                "role": "table_linear",
                "parent": null,
                "sequence": 1,
                "joint": [[0, 0, 0], [0, 1, 0]],
                "limits": {"min": -1000.0, "max": 1000.0},
                "max_velocity": 5000.0
            },
            "Z": {
                "type": "linear",
                "role": "head_linear",
                "parent": null,
                "sequence": 2,
                "joint": [[0, 0, 0], [0, 0, 1]],
                "limits": {"min": -1000.0, "max": 1000.0},
                "max_velocity": 3000.0
            }
        },
        "toolheads": [
            {
                "name": "Default Spindle",
                "toolhead_type": "rotary",
                "max_power_kw": 1.0,
                "max_rpm": 24000,
                "min_rpm": 0,
                "tool_change": false,
                "coolant_flood": false,
                "coolant_mist": false,
                "coolant_delay": 0.0,
                "toolhead_wait": 3.0
            }
        ]
    },
    "version": "1.0",
    "postprocessor": {
        "file_name": "marlin",
        "properties": {
            "preamble": "G90\nG21\nG17",
            "postamble": "M5",
            "file_extension": "gcode"
        }
    },
    "output": {
        "units": "metric",
        "output_tool_length_offset": false,
        "remote_post": false,
        "header": {
            "output_header": true,
            "include_date": true,
            "include_description": true,
            "include_document_name": true,
            "include_machine_name": true,
            "include_project_file": false,
            "include_units": true,
            "include_tool_list": true,
            "include_fixture_list": false
        },
        "comments": {
            "enabled": true,
            "symbol": "()",
            "include_operation_labels": true,
            "include_blank_lines": true,
            "output_bcnc_comments": false
        },
        "formatting": {
            "line_numbers": false,
            "line_number_start": 100,
            "line_number_prefix": "N",
            "line_increment": 10,
            "command_space": " ",
            "end_of_line_chars": "\n"
        },
        "precision": {
            "axis": 3,
            "feed": 3,
            "spindle": 0
        },
        "duplicates": {
            "commands": true,
            "parameters": true
        }
    },
    "processing": {
        "early_tool_prep": false,
        "filter_inefficient_moves": false,
        "split_arcs": false,
        "tool_change": false,
        "translate_drill_cycles": true,
        "translate_rapid_moves": false,
        "xy_before_z_after_tool_change": false
    }
}
