{
    "freecad_version": "26.3.0",
    "machine": {
        "axes": {
            "X": {
                "joint": [
                    [
                        0,
                        0,
                        0
                    ],
                    [
                        1.0,
                        0.0,
                        0.0
                    ]
                ],
                "limits": {
                    "max": 1000.0,
                    "min": -1000.0
                },
                "max_velocity": 5000.0,
                "parent": null,
                "role": "table_linear",
                "sequence": 0,
                "type": "linear"
            },
            "Y": {
                "joint": [
                    [
                        0,
                        0,
                        0
                    ],
                    [
                        0.0,
                        1.0,
                        0.0
                    ]
                ],
                "limits": {
                    "max": 1000.0,
                    "min": -1000.0
                },
                "max_velocity": 5000.0,
                "parent": null,
                "role": "table_linear",
                "sequence": 1,
                "type": "linear"
            },
            "Z": {
                "joint": [
                    [
                        0,
                        0,
                        0
                    ],
                    [
                        0.0,
                        0.0,
                        1.0
                    ]
                ],
                "limits": {
                    "max": 1000.0,
                    "min": -1000.0
                },
                "max_velocity": 3000.0,
                "parent": null,
                "role": "head_linear",
                "sequence": 2,
                "type": "linear"
            }
        },
        "description": "Generic 3-axis CNC machine running Marlin 2.x firmware. Marlin uses G4 S for dwell in seconds (not G4 P). Drill cycles are translated to G0/G1 moves. Tool changes are disabled.",
        "kinematics": {
            "base_frame": {
                "orientation_quaternion": [
                    0,
                    0,
                    0,
                    1
                ],
                "origin": [
                    0,
                    0,
                    0
                ]
            },
            "dwo_supported": false,
            "notes": "Standard 3-axis Cartesian configuration for Marlin-based CNC",
            "rotation_strategy": "none",
            "tcp_supported": false
        },
        "manufacturer": "",
        "name": "Generic Marlin",
        "toolheads": [
            {
                "coolant_delay": 0.0,
                "coolant_flood": false,
                "coolant_mist": false,
                "max_power_kw": 1.0,
                "max_rpm": 24000,
                "min_rpm": 0,
                "name": "Default Spindle",
                "tool_change": false,
                "toolhead_type": "rotary",
                "toolhead_wait": 3.0
            }
        ],
        "units": "metric"
    },
    "output": {
        "comments": {
            "enabled": true,
            "include_blank_lines": true,
            "include_operation_labels": true,
            "output_bcnc_comments": false,
            "symbol": "()"
        },
        "duplicates": {
            "commands": true,
            "parameters": true
        },
        "formatting": {
            "command_space": " ",
            "end_of_line_chars": "\n",
            "line_increment": 10,
            "line_number_prefix": "N",
            "line_number_start": 100,
            "line_numbers": false
        },
        "header": {
            "include_date": true,
            "include_description": true,
            "include_document_name": true,
            "include_fixture_list": false,
            "include_machine_name": true,
            "include_project_file": false,
            "include_tool_list": true,
            "include_units": true,
            "output_header": true
        },
        "output_tool_length_offset": false,
        "precision": {
            "axis": 3,
            "feed": 3,
            "spindle": 0
        },
        "remote_post": false,
        "units": "metric"
    },
    "postprocessor": {
        "file_name": "marlin",
        "properties": {
            "file_extension": "gcode",
            "postamble": "M5",
            "preamble": "G90\nG21\nG17"
        }
    },
    "processing": {
        "assert_tool_prep": false,
        "early_tool_prep": false,
        "filter_inefficient_moves": false,
        "split_arcs": false,
        "tool_change_format": "m6_t",
        "translate_drill_cycles": true,
        "translate_rapid_moves": false,
        "xy_before_z_after_tool_change": false
    },
    "version": 1
}
